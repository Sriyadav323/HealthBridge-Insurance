# Copy to .env for Docker Compose. Supply your own random values; no defaults exist.
POSTGRES_DB=healthbridge
POSTGRES_USER=healthbridge_admin
POSTGRES_PASSWORD=
DB_USERNAME=healthbridge_app
DB_PASSWORD=
FRONTEND_PORT=8088
# Use true only when the browser reaches the app over HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_TIMEOUT=30m
